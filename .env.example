# Pooled Neon connection used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Direct Neon connection used only by Prisma migrations and administrative tasks.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Enable only when the deployment platform is trusted to overwrite proxy headers.
TRUST_PROXY_HEADERS="false"

# Opt-in performance telemetry. Logs contain only route/model/action, status and timings.
PERFORMANCE_LOGS="false"
PERFORMANCE_SLOW_QUERY_MS="100"
NEXT_PUBLIC_PERFORMANCE_LOGS="false"

# Vercel Blob private store used by the centralized media library. Do not use
# the temporary filesystem or Base64 payloads for new media uploads.
BLOB_READ_WRITE_TOKEN=""

# Optional media safeguards. Values are intentionally conservative and can be
# adjusted per deployment without changing the source code.
MEDIA_MAX_IMAGE_BYTES="10485760"
MEDIA_MAX_UPLOAD_FILES="10"
MEDIA_MAX_IMAGE_PIXELS="40000000"
