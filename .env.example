# Pooled Neon connection used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Direct Neon connection used only by Prisma migrations and administrative tasks.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Enable only when the deployment platform is trusted to overwrite proxy headers.
TRUST_PROXY_HEADERS="false"
